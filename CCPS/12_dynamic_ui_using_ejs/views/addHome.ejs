<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
  <%- include('partials/header') %>

  <main class="flex-grow flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-md w-full bg-white rounded-2xl border border-slate-100 shadow-sm p-8">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Add Home to Airbnb</h1>
        <p class="text-slate-500 text-sm mt-1.5">List your property details below to register it.</p>
      </div>

      <form action="/host/add-home" method="POST" class="space-y-5">
        <div>
          <label for="homeName" class="block text-sm font-semibold text-slate-700 mb-1.5">Home Name</label>
          <input type="text" id="homeName" name="home-name" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm transition-colors"
            placeholder="e.g. Elegant Beachside Villa">
        </div>

        <div>
          <label for="location" class="block text-sm font-semibold text-slate-700 mb-1.5">Location</label>
          <input type="text" id="location" name="location" required
            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm transition-colors"
            placeholder="e.g. Malibu, California">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="price" class="block text-sm font-semibold text-slate-700 mb-1.5">Price per Night ($)</label>
            <input type="number" id="price" name="price" required min="1"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm transition-colors"
              placeholder="e.g. 150">
          </div>

          <div>
            <label for="rating" class="block text-sm font-semibold text-slate-700 mb-1.5">Rating (1.0 - 5.0)</label>
            <input type="number" id="rating" name="rating" required min="1" max="5" step="0.1"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm transition-colors"
              placeholder="e.g. 4.9">
          </div>
        </div>

        <div>
          <label for="photoUrl" class="block text-sm font-semibold text-slate-700 mb-1.5">Photo URL (Optional)</label>
          <input type="url" id="photoUrl" name="photo-url"
            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm transition-colors"
            placeholder="e.g. https://images.unsplash.com/photo-...">
        </div>

        <button type="submit"
          class="w-full inline-flex items-center justify-center px-4 py-2.5 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-rose-500 hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition-colors duration-200 mt-2">
          Add Home
        </button>
      </form>

      <div class="mt-6 text-center">
        <a href="/" class="text-sm font-semibold text-rose-500 hover:text-rose-600 transition-colors">
          &larr; Back to Home
        </a>
      </div>
    </div>
  </main>

  <footer class="bg-white border-t border-slate-100 py-6 text-center text-xs text-slate-400">
    <p>&copy; <%= new Date().getFullYear() %> Airbnb Clone. All rights reserved.</p>
  </footer>
</body>
</html>
