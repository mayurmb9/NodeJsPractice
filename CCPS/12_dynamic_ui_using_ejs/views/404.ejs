<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
  <%- include('partials/header') %>

  <main class="flex-grow flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-md w-full bg-white rounded-2xl border border-slate-100 shadow-sm p-8 text-center">
      <div class="w-16 h-16 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-5">
        <svg class="w-8 h-8 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-slate-900">404 - Page Not Found</h1>
      <p class="text-slate-500 text-sm mt-2 max-w-xs mx-auto">Oops! The page you are looking for does not exist or has been moved.</p>

      <div class="mt-8">
        <a href="/" class="inline-flex items-center px-5 py-2.5 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-rose-500 hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition-colors duration-200">
          Go back to Home
        </a>
      </div>
    </div>
  </main>

  <footer class="bg-white border-t border-slate-100 py-6 text-center text-xs text-slate-400">
    <p>&copy; <%= new Date().getFullYear() %> Airbnb Clone. All rights reserved.</p>
  </footer>
</body>
</html>
