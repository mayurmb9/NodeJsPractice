<header class="bg-white border-b border-slate-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 text-rose-500 hover:opacity-90 transition-opacity">
        <svg class="w-8 h-8 fill-current" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 1c-2.008 0-3.69 1.4-4.542 3.328l-8.683 19.3A4.952 4.952 0 001.07 26.6c.49 1.346 1.488 2.454 2.81 3.12A4.95 4.95 0 006.273 30c1.786 0 3.424-.897 4.38-2.399l1.4-2.181a4.992 4.992 0 017.894 0l1.4 2.181C22.303 29.103 23.94 30 25.727 30c.813 0 1.62-.2 2.393-.6a4.986 4.986 0 002.81-3.12 4.95 4.95 0 00-1.705-2.972l-8.683-19.3A5.02 5.02 0 0016 1zm0 3c1.103 0 2.012.784 2.484 1.838l8.682 19.3c.31.69.418 1.442.312 2.176a2.986 2.986 0 01-1.75 1.884 2.97 2.97 0 01-1.428.163c-1.071-.059-2.05-.66-2.617-1.547l-1.4-2.181a6.992 6.992 0 00-11.052 0l-1.4 2.181c-.567.887-1.546 1.488-2.617 1.547a2.97 2.97 0 01-1.428-.163 2.986 2.986 0 01-1.75-1.884 2.956 2.956 0 01.312-2.176l8.682-19.3C13.988 4.784 14.897 4 16 4zm0 6a4.5 4.5 0 100 9 4.5 4.5 0 000-9zm0 2a2.5 2.5 0 110 5 2.5 2.5 0 010-5zm0 1a1.5 1.5 0 100 3 1.5 1.5 0 000-3z"/>
        </svg>
        <span class="text-xl font-bold tracking-tight hidden sm:inline-block">airbnb</span>
      </a>

      <!-- Navigation Links -->
      <nav class="flex items-center space-x-6 h-full">
        <a href="/" class="relative flex items-center h-16 text-sm font-semibold <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'text-rose-500' : 'text-slate-500 hover:text-rose-500' %> transition-colors duration-200">
          Home
          <% if (typeof currentPage !== 'undefined' && currentPage === 'home') { %>
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-rose-500 rounded-t-full"></span>
          <% } %>
        </a>
        <a href="/host/add-home" class="relative flex items-center h-16 text-sm font-semibold <%= typeof currentPage !== 'undefined' && currentPage === 'add-home' ? 'text-rose-500' : 'text-slate-500 hover:text-rose-500' %> transition-colors duration-200">
          Add Home
          <% if (typeof currentPage !== 'undefined' && currentPage === 'add-home') { %>
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-rose-500 rounded-t-full"></span>
          <% } %>
        </a>
      </nav>
    </div>
  </div>
</header>
